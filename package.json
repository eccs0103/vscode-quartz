{
	"name": "quartz-language",
	"displayName": "Quartz language",
	"description": "Complete language support for the Quartz programming language including syntax highlighting, formatting, IntelliSense, and more.",
	"version": "0.6.2",
	"publisher": "eccs0103",
	"repository": {
		"type": "git",
		"url": "https://github.com/eccs0103/vscode-quartz.git"
	},
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.118.0",
		"node": ">=22 <25"
	},
	"categories": [ "Programming Languages", "Formatters", "Linters" ],
	"keywords": [ "quartz", "qrz", "syntax", "highlighting", "formatter", "language-server" ],
	"activationEvents": [ "onLanguage:qrz" ],
	"type": "module",
	"main": "./dist/controllers/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "qrz",
				"aliases": [ "Quartz", "Quartz language" ],
				"extensions": [ ".qrz" ],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "qrz",
				"scopeName": "source.qrz",
				"path": "./syntaxes/qrz.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run typecheck && npm run compile",
		"typecheck": "tsc -p ./",
		"build": "vite build",
		"compile": "vite build",
		"watch": "vite build --watch"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/vscode": "^1.118.0",
		"adaptive-extender": "^1.3.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.7",
		"vscode-languageclient": "^9.0.1",
		"vscode-languageserver": "^9.0.1",
		"vscode-languageserver-textdocument": "^1.0.12"
	}
}
